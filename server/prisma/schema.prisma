datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id String @id @default(cuid())
  email String @unique
  password String
  createdAt DateTime @default(now())
  entries PokemonEntry[]
}

model PokemonEntry {
  id String @id @default(cuid())
  pokemonId Int
  nickname String?
  addedAt DateTime @default(now())
  userId String
  user User @relation(fields: [userId], references: [id])
}